# Chép thành .env.local. Không đưa tệp .env nào lên git.
# Địa chỉ và khoá anon của dự án Supabase (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Tên hiển thị và gốc tên miền (không gạch chéo cuối).
NEXT_PUBLIC_APP_NAME=Intercom
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
# Tuỳ chọn: link mở đơn ở hệ thống của bạn, {id} là mã đơn.
NEXT_PUBLIC_ORDER_URL_TEMPLATE=
